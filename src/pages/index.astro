---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import portrait from '../img/me.JPG';
---

<BaseLayout>
  <main class="shell">
    <header class="site-header">
      <a class="wordmark" href="/">David Dlima</a>
      <nav aria-label="Primary navigation">
        <a href="/writing/">Blog</a>
      </nav>
    </header>

    <section class="intro" aria-label="About David Dlima">
      <div class="intro-copy">
        <p>Hi I'm David D'lima and welcome to my blog!</p>
        <p>I am a machine learning engineer that has worked in a number of different spaces including Ads, Integrity, and Recommendations.</p>
      </div>
      <img class="portrait" src={portrait.src} width={portrait.width} height={portrait.height} alt="David Dlima smiling outdoors" />
    </section>

    <section class="resume-section" aria-labelledby="career-heading">
      <div class="section-heading">
        <p class="section-kicker">Experience</p>
        <h2 id="career-heading">Career</h2>
      </div>
      <ol class="timeline">
        <li>
          <time datetime="2025-09">2025 — now</time>
          <div>
            <h3>Machine Learning Engineer</h3>
            <p>Tinder</p>
          </div>
        </li>
        <li>
          <time datetime="2024-02">2024 — 2025</time>
          <div>
            <h3>Software Engineer</h3>
            <p>Tinder</p>
          </div>
        </li>
        <li>
          <time datetime="2021-01">2021 — 2023</time>
          <div>
            <h3>Software Engineer, Machine Learning</h3>
            <p>Roku</p>
          </div>
        </li>
        <li>
          <time datetime="2018-07">2018 — 2020</time>
          <div>
            <h3>Software Engineer, Machine Learning</h3>
            <p>Capital One</p>
          </div>
        </li>
      </ol>
    </section>

    <section class="resume-section education-section" aria-labelledby="education-heading">
      <div class="section-heading">
        <p class="section-kicker">Study</p>
        <h2 id="education-heading">Education</h2>
      </div>
      <ul class="education-list">
        <li>
          <h3>Georgia Institute of Technology</h3>
          <p>Master of Science</p>
        </li>
        <li>
          <h3>The Ohio State University</h3>
          <p>Bachelor's degree</p>
        </li>
      </ul>
    </section>

    <Footer />
  </main>
</BaseLayout>
