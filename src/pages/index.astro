---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout>
  <main class="shell">
    <header class="site-header">
      <a class="wordmark" href="/">David Dlima</a>
      <nav aria-label="Primary navigation">
        <a href="/writing/">Blog</a>
      </nav>
    </header>

    <section class="intro" aria-label="About David Dlima">
      <div class="intro-copy">
        <p>Hi I'm David D'lima. I am a machine learning engineer that has worked in a number of different spaces including Ads, Integrity, and Recommendations.<p>
      </div>
      <img class="portrait" src="/images/david-dlima.jpg" width="1698" height="1740" alt="David Dlima smiling outdoors" />
    </section>

    <Footer />
  </main>
</BaseLayout>
