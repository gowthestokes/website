---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Message sent · David Dlima" description="Your message has been sent to David Dlima.">
  <main class="shell">
    <header class="site-header">
      <a class="wordmark" href="/">David Dlima</a>
      <nav aria-label="Primary navigation">
        <a href="/writing/">Blog</a>
        <a href="/background/">Background</a>
      </nav>
    </header>

    <section class="contact-page contact-thanks" aria-labelledby="thanks-heading">
      <p class="eyebrow">Message sent</p>
      <h1 id="thanks-heading">Thanks for reaching out.</h1>
      <p class="contact-intro">I’ll get back to you as soon as I can.</p>
      <a class="form-submit" href="/">Back home <span aria-hidden="true">→</span></a>
    </section>

    <Footer />
  </main>
</BaseLayout>
