---
import '../styles/global.css';
import favicon from '../img/david-favicon.png';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'David Dlima',
  description = 'David Dlima — machine learning engineer.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f3e8" />
    <link rel="icon" type="image/png" href={favicon.src} />
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-W8W0PTB7LX"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-W8W0PTB7LX');
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=IBM+Plex+Mono:wght@400;500&family=Source+Serif+4:opsz,wght@8..60,400..700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <div class="scroll-progress" aria-hidden="true"></div>
    <slot />
    <script is:inline>
      const updateScrollProgress = () => {
        const page = document.documentElement;
        const scrollableHeight = page.scrollHeight - window.innerHeight;
        const progress = scrollableHeight > 0 ? (window.scrollY / scrollableHeight) * 100 : 0;
        page.style.setProperty('--scroll-progress', `${Math.min(100, progress)}%`);
      };

      updateScrollProgress();
      window.addEventListener('scroll', updateScrollProgress, { passive: true });
      window.addEventListener('resize', updateScrollProgress);
    </script>
  </body>
</html>
